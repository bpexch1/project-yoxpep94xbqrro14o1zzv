{
  "name": "Client",
  "description": "A client or user in the exchange system",
  "properties": {
    "username": {
      "type": "string",
      "description": "The unique username of the client"
    },
    "full_name": {
      "type": "string",
      "description": "The full name of the client"
    },
    "role": {
      "type": "string",
      "description": "The role of the client (superadmin, admin, agent, client)"
    },
    "credit_received": {
      "type": "number",
      "description": "Total credit received by the client"
    },
    "credit_remaining": {
      "type": "number",
      "description": "Current credit remaining for the client"
    },
    "cash": {
      "type": "number",
      "description": "Cash balance of the client"
    },
    "pl_downline": {
      "type": "number",
      "description": "Profit/Loss from downline"
    },
    "balance_upline": {
      "type": "number",
      "description": "Balance with upline"
    },
    "status": {
      "type": "string",
      "description": "Current status (active, inactive)"
    },
    "parent_username": {
      "type": "string",
      "description": "The username of the parent admin/agent"
    },
    "phone": {
      "type": "string",
      "description": "Phone number of the client"
    },
    "downline_share": {
      "type": "number",
      "description": "Downline share percentage (0-85)"
    },
    "reference": {
      "type": "string",
      "description": "Reference note for the client"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the client"
    }
  }
}