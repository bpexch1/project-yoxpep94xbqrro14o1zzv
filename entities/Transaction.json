{
  "name": "Transaction",
  "description": "A cash or credit transaction record",
  "properties": {
    "client_username": {
      "type": "string",
      "description": "The username of the client involved in the transaction"
    },
    "type": {
      "type": "string",
      "description": "The type of transaction (cash, credit)"
    },
    "amount": {
      "type": "number",
      "description": "The amount of the transaction"
    },
    "description": {
      "type": "string",
      "description": "A description of the transaction"
    },
    "before_balance": {
      "type": "number",
      "description": "Balance before the transaction"
    },
    "after_balance": {
      "type": "number",
      "description": "Balance after the transaction"
    }
  }
}