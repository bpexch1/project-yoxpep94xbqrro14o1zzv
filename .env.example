# Required browser-safe Supabase connection; no mock financial fallback.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional external backend API URL
VITE_API_BASE_URL=

# Microsoft Clarity Analytics Project ID (e.g. your custom Clarity Project ID)
VITE_CLARITY_PROJECT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ATD Cricket API Key (optional)
ATD_API_KEY=

# RapidAPI Credentials (Cricbuzz / SportAPI7 / Betfair Exchange API)
RAPIDAPI_KEY=
RAPIDAPI_HOST=sportapi7.p.rapidapi.com
VITE_RAPIDAPI_KEY=
VITE_RAPIDAPI_HOST=sportapi7.p.rapidapi.com
VITE_CRICBUZZ_HOST=cricbuzz-cricket.p.rapidapi.com

# Server secrets: configure in Supabase Edge Function secrets, never VITE_ variables.
# BETFAIR_APP_KEY=
# BETFAIR_SESSION_TOKEN=
# BETFAIR_FEED_LICENSE_CONFIRMED=true
